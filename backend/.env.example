PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/notemark

# CORS: which origins may call this API. Only relevant if you ever add a
# separate web dashboard — the Chrome extension itself calls this API from
# a background service worker, which isn't subject to browser CORS the same
# way a webpage is (see backend/README.md "CORS note").
CLIENT_URL=http://localhost:5173

# Must match the extension's manifest.config.ts host_permissions entry.
EXTENSION_ID=

# This backend's OWN license/subscription verification is a SEPARATE,
# already-live service the extension calls directly
# (https://nexusbackend-ookk.onrender.com) — it is NOT part of this repo and
# NOT the same thing as this backend. Do not confuse the two. See
# backend/README.md.
