PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/notemark

# CORS: which origins may call this API. Only relevant if you add a separate
# web dashboard. The Chrome extension calls this API from a background service
# worker and is not subject to browser CORS the same way a webpage is.
CLIENT_URL=http://localhost:5173

# External CodersNexus license service used to authorize cloud sync writes.
LICENSE_VERIFY_URL=https://cnexusbackend.onrender.com/api/subscriptions/verify
LICENSE_PRODUCT_ID=6a7ae899e65a8aa481d69388
LICENSE_EXTENSION_SLUG=notemark
